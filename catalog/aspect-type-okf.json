{
  "name": "okf",
  "type": "record",
  "recordFields": [
    {
      "name": "type",
      "type": "string",
      "index": 1,
      "annotations": {
        "displayName": "Type",
        "description": "OKF concept type. The only field OKF requires."
      }
    },
    {
      "name": "title",
      "type": "string",
      "index": 2,
      "annotations": {
        "displayName": "Title"
      }
    },
    {
      "name": "description",
      "type": "string",
      "index": 3,
      "annotations": {
        "displayName": "Description"
      }
    },
    {
      "name": "timestamp",
      "type": "datetime",
      "index": 4,
      "annotations": {
        "displayName": "Last meaningful edit",
        "description": "RFC3339 timestamp of the last meaningful edit to the underlying knowledge, taken from the source document rather than the conversion run."
      }
    },
    {
      "name": "status",
      "type": "enum",
      "index": 5,
      "enumValues": [
        { "name": "draft", "index": 1 },
        { "name": "stable", "index": 2 },
        { "name": "deprecated", "index": 3 }
      ],
      "annotations": {
        "displayName": "Lifecycle status",
        "description": "OKF lifecycle signal."
      }
    },
    {
      "name": "stale_after",
      "type": "datetime",
      "index": 6,
      "annotations": {
        "displayName": "Stale after",
        "description": "Freshness trust signal: absolute RFC3339 deadline after which this concept must be re-verified before an agent relies on it."
      }
    },
    {
      "name": "sources",
      "type": "string",
      "index": 7,
      "annotations": {
        "displayName": "Sources",
        "description": "Provenance: newline-separated source URIs this concept was derived from."
      }
    },
    {
      "name": "generated_by",
      "type": "string",
      "index": 8,
      "annotations": {
        "displayName": "Generated by",
        "description": "Identity of the agent or person that generated this concept."
      }
    },
    {
      "name": "generated_at",
      "type": "datetime",
      "index": 9,
      "annotations": {
        "displayName": "Generated at"
      }
    },
    {
      "name": "generated_method",
      "type": "string",
      "index": 10,
      "annotations": {
        "displayName": "Generation method",
        "description": "How the concept was produced, including any model-reconstructed content."
      }
    },
    {
      "name": "verified",
      "type": "string",
      "index": 11,
      "annotations": {
        "displayName": "Verification events",
        "description": "Verification events actually performed, as by/at/scope triples. Absence of a human entry means no human review has occurred."
      }
    },
    {
      "name": "corpus",
      "type": "string",
      "index": 12,
      "annotations": {
        "displayName": "Corpus"
      }
    },
    {
      "name": "version_tag",
      "type": "string",
      "index": 13,
      "annotations": {
        "displayName": "Version tag",
        "description": "Corpus-wide batch identifier, e.g. GEAPL200_2026-09-30_124746."
      }
    },
    {
      "name": "source_doc_id",
      "type": "string",
      "index": 14,
      "annotations": {
        "displayName": "Source document id",
        "description": "Stable identity of the upstream document. Use this as the graph node key, not the filename, which changes on retitling."
      }
    },
    {
      "name": "content_sha256",
      "type": "string",
      "index": 15,
      "annotations": {
        "displayName": "Content SHA-256",
        "description": "SHA-256 of the concept body excluding frontmatter, so a version bump does not look like a content change."
      }
    }
  ]
}
